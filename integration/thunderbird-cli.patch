diff --git a/bridge/read-only.js b/bridge/read-only.js
new file mode 100644
index 0000000..26569dc
--- /dev/null
+++ b/bridge/read-only.js
@@ -0,0 +1,6 @@
+export function isReadOnlyRoute(method, path) {
+  if (method === "GET") return ["/bridge/status", "/health", "/inbox-zero/accounts"].includes(path);
+  return method === "POST" && [
+    "/inbox-zero/folders", "/inbox-zero/messages", "/inbox-zero/message",
+  ].includes(path);
+}
