+import { env } from "@/env";
+
+export function isLocalThunderbirdEnabled() {
+  if (!env.LOCAL_THUNDERBIRD_ENABLED) return false;
+  const url = new URL(env.NEXT_PUBLIC_BASE_URL);
+  if (
+    url.protocol !== "http:" ||
+    !["localhost", "127.0.0.1"].includes(url.hostname)
+  ) {
+    throw new Error(
+      "Local Thunderbird login requires a loopback application URL",
+    );
+  }
+  if (!env.THUNDERBIRD_BRIDGE_URL || !env.THUNDERBIRD_BRIDGE_TOKEN) {
+    throw new Error("Local Thunderbird requires private bridge configuration");
+  }
+  return true;
+}
