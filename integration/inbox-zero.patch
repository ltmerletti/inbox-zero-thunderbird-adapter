@@ -0,0 +1,34 @@
+name: inbox-zero-thunderbird
+services:
+  db:
+    image: postgres:16
+    environment:
+      POSTGRES_USER: postgres
+      POSTGRES_DB: inboxzero
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?private env file required}
+    ports: ["127.0.0.1:5446:5432"]
+    volumes: ["thunderbird-db:/var/lib/postgresql/data"]
+    mem_limit: 512m
+    restart: unless-stopped
+    healthcheck:
+      test: [CMD-SHELL, pg_isready -U postgres]
+      interval: 5s
+      timeout: 5s
+      retries: 20
+  redis:
+    image: redis:7
+    ports: ["127.0.0.1:6386:6379"]
+    mem_limit: 64m
+    restart: unless-stopped
+  redis-http:
+    image: hiett/serverless-redis-http:latest
+    environment:
+      SRH_MODE: env
+      SRH_TOKEN: ${REDIS_HTTP_TOKEN:?private env file required}
+      SRH_CONNECTION_STRING: redis://redis:6379
+    ports: ["127.0.0.1:8076:80"]
+    depends_on: [redis]
+    mem_limit: 128m
+    restart: unless-stopped
+volumes:
+  thunderbird-db:
