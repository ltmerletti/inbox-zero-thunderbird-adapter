+import { createHash } from "node:crypto";
+import type { EmailProvider, EmailFolderCount } from "@/utils/email/types";
+import type { ParsedMessage } from "@/utils/types";
+
+export type ThunderbirdAccount = {
+  id: string;
+  name: string;
+  type: string;
+  email: string;
+};
+export type ThunderbirdFolder = {
+  id: string;
+  accountId: string;
+  name: string;
+  path: string;
+  specialUse: string[];
+  total: number;
+  unread: number;
+};
+type ThunderbirdMessage = {
+  id: number;
+  accountId: string;
+  folderId: string;
+  date: string;
+  author: string;
+  recipients: string[];
+  ccList: string[];
+  subject: string;
+  headerMessageId: string;
+  read: boolean;
+  flagged: boolean;
+  tags: string[];
+  headers?: Record<string, string[]>;
+  parts?: {
+    text: string;
+    html: string;
+    attachments: {
+      partName: string;
+      name: string;
+      contentType: string;
+      size: number;
+    }[];
+  };
+};
+
+type ThunderbirdReader = Pick<
+  EmailProvider,
+  | "getMessage"
+  | "getMessagesWithPagination"
+  | "getInboxMessages"
+  | "getInboxStats"
+  | "getFolderCounts"
+>;
+
+const messageReferences = new Map<string, Map<string, number>>();
+
+export class ThunderbirdMailReader implements ThunderbirdReader {
+  readonly name = "thunderbird";
+  readonly readOnly = false;
+  private readonly baseUrl: string;
+  private readonly token: string;
+  protected readonly accountId?: string;
+
+  constructor({
+    baseUrl,
+    token,
+    accountId,
+  }: { baseUrl: string; token: string; accountId?: string }) {
+    const url = new URL(baseUrl);
+    if (
+      url.protocol !== "http:" ||
+      url.hostname !== "127.0.0.1" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash ||
+      url.pathname !== "/"
+    ) {
+      throw new Error(
+        "Thunderbird bridge must use an HTTP address on 127.0.0.1",
+      );
+    }
+    if (token.length < 32)
+      throw new Error(
+        "A private bridge token of at least 32 characters is required",
+      );
+    this.baseUrl = url.origin;
+    this.token = token;
+    this.accountId = accountId;
+  }
+
+  async getStatus() {
+    return this.request<{
+      bridge: string;
+      extension: string;
+      readOnly: boolean;
+      canMove: boolean;
+    }>("GET", "/bridge/status");
+  }
+
+  async getAccounts() {
+    return this.request<ThunderbirdAccount[]>("GET", "/inbox-zero/accounts");
+  }
+
+  async getThunderbirdFolders() {
+    const folders = await this.request<ThunderbirdFolder[]>(
+      "POST",
+      "/inbox-zero/folders",
+      {
+        accountId: this.selectedAccount(),
+      },
+    );
+    if (
+      !Array.isArray(folders) ||
+      folders.some((folder) => folder.accountId !== this.accountId)
+    ) {
+      throw new Error("Bridge returned folders outside the selected account");
+    }
+    return folders;
+  }
+
+  async getFolderCounts(): Promise<EmailFolderCount[]> {
+    return (await this.getThunderbirdFolders()).map((folder) => ({
+      id: folder.id,
+      name: folder.name,
+      total: folder.total,
+      unread: folder.unread,
+    }));
+  }
+
+  async getMessage(messageId: string): Promise<ParsedMessage> {
+    const message = await this.resolveNativeMessage(messageId);
+    return withFolderRole(
+      toInboxZeroMessage(message),
+      await this.getThunderbirdFolders(),
+    );
+  }
+
+  async moveMessageToFolder(
+    messageId: string,
+    folderId: string,
+  ): Promise<void> {
+    const folders = await this.getThunderbirdFolders();
+    if (!folders.some((folder) => folder.id === folderId))
+      throw new Error("Destination folder not found in this account");
+    const message = await this.resolveNativeMessage(messageId);
+    await this.request("POST", "/inbox-zero/move", {
+      accountId: this.selectedAccount(),
+      messageId: message.id,
+      folderId,
+      expectedIdentity: JSON.stringify([
+        message.folderId,
+        message.headerMessageId || [
+          message.date,
+          message.author,
+          message.subject,
+        ],
+      ]),
+    });
+    this.references().delete(messageId);
+  }
+
+  private async resolveNativeMessage(
+    messageId: string,
+  ): Promise<ThunderbirdMessage> {
+    parseMessageId(messageId, this.selectedAccount());
+    const references = this.references();
+    let id = references.get(messageId);
+    if (!id) id = await this.findMessageReference(messageId);
+    let message: ThunderbirdMessage | undefined;
+    try {
+      message = await this.readNativeMessage(id);
+    } catch (error) {
+      if (
+        !(error instanceof Error) ||
+        !/message.*not found/i.test(error.message)
+      )
+        throw error;
+    }
+    if (!message || toInboxZeroMessage(message).id !== messageId) {
+      references.delete(messageId);
+      id = await this.findMessageReference(messageId);
+      message = await this.readNativeMessage(id);
+      if (toInboxZeroMessage(message).id !== messageId)
+        throw new ThunderbirdMessageNotFoundError(
+          "Message not found: Thunderbird's message IDs changed; refresh the mailbox",
+        );
+    }
+    return message;
+  }
+
+  async getMessagesWithPagination(
+    options: Parameters<EmailProvider["getMessagesWithPagination"]>[0] = {},
+  ) {
+    if (options.before || options.after) {
+      throw new Error("Date filters are not supported by this adapter yet");
+    }
+    const limit = options.maxResults ?? 25;
+    if (!Number.isInteger(limit) || limit < 1 || limit > 100)
+      throw new Error("Page size must be 1–100");
+    let folderId = options.folderId;
+    if (options.inboxOnly) {
+      const folders = await this.getThunderbirdFolders();
+      const inbox = folders.find((folder) =>
+        folder.specialUse.includes("inbox"),
+      );
+      if (!inbox)
+        throw new Error("This account has no identifiable inbox folder");
+      folderId = inbox.id;
+    }
+    const page = await this.request<{
+      messages: ThunderbirdMessage[];
+      nextCursor?: string;
+    }>("POST", "/inbox-zero/messages", {
+      accountId: this.selectedAccount(),
+      folderId,
+      limit,
+      query: options.query,
+      unreadOnly: options.unreadOnly,
+      cursor: options.pageToken,
+    });
+    if (!Array.isArray(page.messages))
+      throw new Error("Bridge returned an invalid message page");
+    for (const message of page.messages) this.assertMessageAccount(message);
+    const folders = await this.getThunderbirdFolders();
+    const references = this.references();
+    const messages = page.messages.map((message) => {
+      const parsed = withFolderRole(toInboxZeroMessage(message), folders);
+      references.set(parsed.id, message.id);
+      return parsed;
+    });
+    return { messages, nextPageToken: page.nextCursor };
+  }
+
+  async getInboxMessages(maxResults = 25) {
+    return (
+      await this.getMessagesWithPagination({ inboxOnly: true, maxResults })
+    ).messages;
+  }
+
+  async getInboxStats() {
+    const folders = await this.getThunderbirdFolders();
+    const inbox = folders.find((folder) => folder.specialUse.includes("inbox"));
+    if (!inbox)
+      throw new Error("This account has no identifiable inbox folder");
+    return { total: inbox.total, unread: inbox.unread };
+  }
+
+  protected selectedAccount() {
+    if (!this.accountId)
+      throw new Error("Select a Thunderbird account before reading mail");
+    return this.accountId;
+  }
+
+  private references() {
+    const account = this.selectedAccount();
+    let references = messageReferences.get(account);
+    if (!references) {
+      references = new Map();
+      messageReferences.set(account, references);
+    }
+    return references;
+  }
+
+  private async readNativeMessage(id: number) {
+    const message = await this.request<ThunderbirdMessage>(
+      "POST",
+      "/inbox-zero/message",
+      { accountId: this.accountId, messageId: id },
+    );
+    this.assertMessageAccount(message);
+    return message;
+  }
+
+  private async findMessageReference(messageId: string): Promise<number> {
+    let pageToken: string | undefined;
+    do {
+      const page = await this.getMessagesWithPagination({
+        maxResults: 100,
+        pageToken,
+        includeDrafts: true,
+      });
+      if (page.messages.some((message) => message.id === messageId))
+        return this.references().get(messageId)!;
+      pageToken = page.nextPageToken;
+    } while (pageToken);
+    throw new ThunderbirdMessageNotFoundError(
+      "Message not found: Thunderbird's message IDs changed or the message was moved; refresh the mailbox",
+    );
+  }
+
+  private assertMessageAccount(message: ThunderbirdMessage) {
+    if (message.accountId !== this.selectedAccount())
+      throw new Error("Message belongs to another account");
+    if (
+      !Number.isSafeInteger(message.id) ||
+      message.id < 1 ||
+      !Number.isFinite(Date.parse(message.date))
+    ) {
+      throw new Error("Bridge returned invalid message metadata");
+    }
+  }
+
+  private async request<T>(
+    method: "GET" | "POST",
+    path: string,
+    body?: unknown,
+  ): Promise<T> {
+    const response = await fetch(`${this.baseUrl}${path}`, {
+      method,
+      redirect: "error",
+      signal: AbortSignal.timeout(10_000),
+      headers: {
+        Authorization: `Bearer ${this.token}`,
+        "Content-Type": "application/json",
+        "X-TB-Timeout": "8000",
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const data = await response.json();
+    if (!response.ok || data?.error) {
+      throw new Error(
+        data?.error || `Thunderbird bridge returned HTTP ${response.status}`,
+      );
+    }
+    return data as T;
+  }
+}
+
+function parseMessageId(value: string, accountId: string) {
+  const prefix = `tb:${encodeURIComponent(accountId)}:`;
+  if (!value.startsWith(prefix))
+    throw new Error("Message ID belongs to another account");
+  if (!/^[a-f0-9]{32}$/.test(value.slice(prefix.length)))
+    throw new ThunderbirdMessageNotFoundError(
+      "Invalid message ID: cached Thunderbird reference is no longer available",
+    );
+}
+
+class ThunderbirdMessageNotFoundError extends Error {
+  readonly status = 404;
+}
+
+function withFolderRole(
+  message: ParsedMessage,
+  folders: ThunderbirdFolder[],
+): ParsedMessage {
+  const roles: Record<string, string> = {
+    inbox: "INBOX",
+    sent: "SENT",
+    drafts: "DRAFT",
+    trash: "TRASH",
+    junk: "SPAM",
+    archives: "ARCHIVE",
+  };
+  const folder = folders.find((folder) => folder.id === message.parentFolderId);
+  const labels = (folder?.specialUse ?? [])
+    .map((role) => roles[role])
+    .filter(Boolean);
+  return { ...message, labelIds: [...(message.labelIds ?? []), ...labels] };
+}
+
+export function toInboxZeroMessage(message: ThunderbirdMessage): ParsedMessage {
+  // Thunderbird's numeric IDs can be reused after restart. A fingerprint
+  // prevents a cached reference from opening a different email.
+  const identity = JSON.stringify([
+    message.folderId,
+    message.headerMessageId || [message.date, message.author, message.subject],
+  ]);
+  const fingerprint = createHash("sha256")
+    .update(identity)
+    .digest("hex")
+    .slice(0, 32);
+  const id = `tb:${encodeURIComponent(message.accountId)}:${fingerprint}`;
+  const header = (name: string) => message.headers?.[name]?.join(" ");
+  const textPlain = message.parts?.text;
+  const textHtml = message.parts?.html;
+  const labelIds = [...message.tags];
+  if (!message.read) labelIds.push("UNREAD");
+  if (message.flagged) labelIds.push("STARRED");
+  return {
+    id,
+    // Conversation grouping will require RFC reference indexing.
+    threadId: id,
+    historyId: "",
+    date: message.date,
+    internalDate: String(Date.parse(message.date)),
+    parentFolderId: message.folderId,
+    subject: message.subject,
+    snippet: textPlain?.trim().replace(/\s+/g, " ").slice(0, 200) || "",
+    textPlain,
+    textHtml,
+    bodyContentType: textPlain ? "text" : textHtml ? "html" : undefined,
+    labelIds,
+    inline: [],
+    hasAttachment: message.parts
+      ? !!message.parts.attachments.length
+      : undefined,
+    attachments: message.parts?.attachments.map((attachment) => ({
+      attachmentId: attachment.partName,
+      filename: attachment.name,
+      mimeType: attachment.contentType,
+      size: attachment.size,
+      headers: {
+        "content-description": "",
+        "content-id": "",
+        "content-transfer-encoding": "",
+        "content-type": attachment.contentType,
+      },
+    })),
+    headers: {
+      from: message.author,
+      to: message.recipients.join(", "),
+      cc: message.ccList.join(", "),
+      subject: message.subject,
+      date: header("date") || message.date,
+      "message-id": header("message-id") || message.headerMessageId,
+      "in-reply-to": header("in-reply-to"),
+      references: header("references"),
+      "reply-to": header("reply-to"),
+      "list-unsubscribe": header("list-unsubscribe"),
+      "list-unsubscribe-post": header("list-unsubscribe-post"),
+    },
+  };
+}
