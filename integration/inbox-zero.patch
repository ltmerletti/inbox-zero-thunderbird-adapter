@@ -0,0 +1,137 @@
+import { describe, expect, it, vi } from "vitest";
+import { ThunderbirdProvider } from "./thunderbird-provider";
+import type { ParsedMessage } from "@/utils/types";
+
+function message(id: string, read = false): ParsedMessage {
+  return {
+    id,
+    threadId: id,
+    date: "2026-01-01T00:00:00Z",
+    internalDate: "1767225600000",
+    historyId: "",
+    subject: "Example",
+    snippet: "",
+    inline: [],
+    labelIds: read ? ["INBOX"] : ["INBOX", "UNREAD"],
+    headers: {
+      from: "sender@example.com",
+      to: "owner@example.com",
+      subject: "Example",
+      date: "2026-01-01",
+    },
+  };
+}
+function reader(accountId: string) {
+  return new ThunderbirdProvider({
+    baseUrl: "http://127.0.0.1:7700",
+    token: "test-token-".repeat(5),
+    accountId,
+  });
+}
+
+describe("Thunderbird provider snapshot synchronization", () => {
+  it("resolves folder IDs and refuses ambiguous names before moving", async () => {
+    const provider = reader("folder-test");
+    vi.spyOn(provider, "getThunderbirdFolders").mockResolvedValue([
+      {
+        id: "first",
+        accountId: "folder-test",
+        name: "Applications",
+        path: "/Applications",
+        specialUse: [],
+        total: 0,
+        unread: 0,
+      },
+      {
+        id: "second",
+        accountId: "folder-test",
+        name: "Applications",
+        path: "/Archive/Applications",
+        specialUse: [],
+        total: 0,
+        unread: 0,
+      },
+    ]);
+    const move = vi.spyOn(provider, "moveMessageToFolder").mockResolvedValue();
+    await expect(
+      provider.moveThreadToFolder(
+        "one",
+        "owner@example.invalid",
+        "Applications",
+      ),
+    ).rejects.toThrow("ambiguous");
+    expect(move).not.toHaveBeenCalled();
+    await provider.moveThreadToFolder("one", "owner@example.invalid", "second");
+    expect(move).toHaveBeenCalledWith("one", "second");
+  });
+  it("paginates snapshots, replays retries, and reports changed flags and deleted messages", async () => {
+    const provider = reader("snapshot-test");
+    const list = vi.spyOn(provider, "getMessagesWithPagination");
+    list.mockResolvedValue({
+      messages: [message("one"), message("two")],
+      nextPageToken: undefined,
+    });
+    const baseline = await provider.getMailboxSyncPage({
+      after: new Date(0),
+      limit: 1,
+    });
+    const first = await provider.getMailboxSyncPage({
+      cursor: baseline.cursor,
+      limit: 1,
+    });
+    expect(first.upsertedMessages.map((m) => m.id)).toEqual(["one"]);
+    expect(first.hasMore).toBe(true);
+    expect(
+      await provider.getMailboxSyncPage({ cursor: baseline.cursor, limit: 1 }),
+    ).toEqual(first);
+    const second = await provider.getMailboxSyncPage({
+      cursor: first.cursor,
+      limit: 1,
+    });
+    expect(second.upsertedMessages.map((m) => m.id)).toEqual(["two"]);
+    expect(second.hasMore).toBe(false);
+    list.mockResolvedValue({
+      messages: [message("two", true), message("three")],
+      nextPageToken: undefined,
+    });
+    const changed = await provider.getMailboxSyncPage({
+      cursor: second.cursor,
+      limit: 100,
+    });
+    expect(changed.upsertedMessages.map((m) => m.id)).toEqual(["two", "three"]);
+    expect(changed.deletedMessageIds).toEqual(["one"]);
+    expect(list).toHaveBeenCalledTimes(2);
+  });
+  it("rejects a sync cursor from a different mailbox and resets unknown positions", async () => {
+    const a = reader("isolated-a"),
+      b = reader("isolated-b");
+    const baseline = await a.getMailboxSyncPage({
+      after: new Date(0),
+      limit: 1,
+    });
+    await b.getMailboxSyncPage({ after: new Date(0), limit: 1 });
+    expect(
+      (await b.getMailboxSyncPage({ cursor: baseline.cursor, limit: 50 }))
+        .reset,
+    ).toBe(true);
+    expect(
+      (await a.getMailboxSyncPage({ cursor: "expired", limit: 50 })).reset,
+    ).toBe(true);
+  });
+  it("fails writes without dispatching a request to Thunderbird", () => {
+    const provider = reader("read-only-test");
+    const fetchSpy = vi.spyOn(globalThis, "fetch");
+    expect(() =>
+      provider.trashThread("one", "owner@example.com", "user"),
+    ).toThrow("only supports reading and moving");
+    expect(() =>
+      provider.sendEmail({
+        to: "someone@example.com",
+        subject: "Hello",
+        messageText: "Hello",
+      }),
+    ).toThrow("only supports reading and moving");
+    expect(fetchSpy).not.toHaveBeenCalled();
+    fetchSpy.mockRestore();
+  });
+});
diff --git a/apps/web/utils/email/thunderbird-provider.ts b/apps/web/utils/email/thunderbird-provider.ts
