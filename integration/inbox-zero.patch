+  }
+  async getThreads(folderId?: string) {
+    return (await this.getThreadsWithQuery({ query: { folderId } })).threads;
+  }
+  async getThreadsWithLabel({
+    labelId,
+    maxResults,
+  }: Parameters<EmailProvider["getThreadsWithLabel"]>[0]) {
+    return (await this.getThreadsWithQuery({ query: { labelId }, maxResults }))
+      .threads;
+  }
+  async getDrafts({ maxResults }: { maxResults?: number } = {}) {
+    return this.messagesInRole("drafts", maxResults);
+  }
+  async getSentMessages(maxResults?: number) {
+    return this.messagesInRole("sent", maxResults);
+  }
+  async getDraft(id: string) {
+    const message = await this.getMessage(id);
+    return message.labelIds?.includes("DRAFT") ? message : null;
+  }
+  async getDraftReferenceForMessage(id: string) {
+    return (await this.getDraft(id)) ? { id } : null;
+  }
+
+  async searchMessages(
+    options: Parameters<EmailProvider["searchMessages"]>[0],
+  ) {
+    if (
+      options.fromEmail ||
+      options.labelName ||
+      (options.labelIds?.length ?? 0) > 1
+    )
+      unsupported();
+    const search = options.mailboxSearch;
+    if (
+      search?.hasAttachment !== undefined ||
+      search?.starred !== undefined ||
+      search?.excludedRoles?.length
+    )
+      unsupported();
+    if (search?.text && !["any", "subject"].includes(search.text.field))
+      unsupported();
+    let folderId = options.labelIds?.[0];
+    const mailbox = search?.mailbox ?? options.folder;
+    if (mailbox && mailbox !== "all" && mailbox !== "inbox") {
+      const role = (
+        {
+          drafts: "drafts",
+          sent: "sent",
+          trash: "trash",
+          spam: "junk",
+          archive: "archives",
+        } as Record<string, string>
+      )[mailbox];
+      if (!role) unsupported();
+      folderId = (await this.getThunderbirdFolders()).find((folder) =>
+        folder.specialUse.includes(role),
+      )?.id;
+      if (!folderId) return { messages: [], nextPageToken: undefined };
+    }
+    const page = await this.getMessagesWithPagination({
+      query: search?.text?.value ?? options.query,
+      maxResults: options.maxResults,
+      pageToken: options.pageToken,
+      folderId,
+      inboxOnly: mailbox === "inbox",
+      unreadOnly: search?.read === false || options.readState === "unread",
+    });
+    const messages = page.messages.filter(
+      (message) =>
+        search?.read !== true || !message.labelIds?.includes("UNREAD"),
+    );
+    return { ...page, messages };
+  }
+  async searchThreads(options: Parameters<EmailProvider["searchThreads"]>[0]) {
+    const page = await this.searchMessages(options);
+    return {
+      threads: page.messages.map(asThread),
+      nextPageToken: page.nextPageToken,
+    };
+  }
+
+  async getMailboxSyncPage({
+    cursor,
+    after,
+    limit,
+  }: Parameters<
+    EmailProvider["getMailboxSyncPage"]
+  >[0]): Promise<MailboxSyncPage> {
+    const key = this.selectedAccount();
+    let state = snapshots.get(key);
+    if (after) {
+      state = { cursor: randomUUID(), messages: new Map(), replies: new Map() };
+      snapshots.set(key, state);
+      return emptyPage(state.cursor);
+    }
+    if (!state || !cursor) return { ...emptyPage(""), reset: true };
+    const replay = state.replies.get(cursor);
+    if (replay) return replay;
+    if (cursor !== state.cursor) return { ...emptyPage(""), reset: true };
+    if (!state.pending) {
+      state.scan ??= this.scanSnapshot(state).finally(() => {
+        if (state) state.scan = undefined;
+      });
+      await state.scan;
+    }
+    const cached = state.replies.get(cursor);
+    if (cached) return cached;
+    if (cursor !== state.cursor) return { ...emptyPage(""), reset: true };
+    const pending = state.pending!;
+    const changed = pending.messages.splice(0, Math.min(limit, 100));
+    const hasMore = pending.messages.length > 0;
+    const next = randomUUID();
+    const page: MailboxSyncPage = {
+      cursor: next,
+      upsertedMessages: changed,
+      deletedMessageIds: hasMore ? [] : pending.deleted,
+      hasMore,
+      reset: false,
+    };
+    state.replies.set(cursor, page);
+    if (state.replies.size > 200)
+      state.replies.delete(state.replies.keys().next().value!);
+    state.cursor = next;
+    if (!hasMore) {
+      state.messages = pending.snapshot;
+      state.pending = undefined;
+    }
+    return page;
+  }
+
+  private async scanSnapshot(
+    state: NonNullable<ReturnType<typeof snapshots.get>>,
+  ) {
+    const snapshot = new Map<string, ParsedMessage>();
+    let token: string | undefined;
+    do {
+      const page = await this.getMessagesWithPagination({
+        maxResults: 100,
+        pageToken: token,
+        includeDrafts: true,
+      });
+      for (const message of page.messages) snapshot.set(message.id, message);
+      token = page.nextPageToken;
+    } while (token);
+    state.pending = {
+      snapshot,
+      messages: [...snapshot.values()].filter(
+        (message) =>
+          JSON.stringify(message) !==
+          JSON.stringify(state.messages.get(message.id)),
+      ),
+      deleted: [...state.messages.keys()].filter((id) => !snapshot.has(id)),
+    };
+  }
+  private async messagesInRole(role: string, maxResults?: number) {
+    const folder = (await this.getThunderbirdFolders()).find((folder) =>
+      folder.specialUse.includes(role),
+    );
+    if (!folder) return [];
+    return (
+      await this.getMessagesWithPagination({ folderId: folder.id, maxResults })
+    ).messages;
+  }
+
+  async syncLocalMail() {
+    return {
+      status: "unsupported",
+      strategy: this.localMailSyncStrategy,
+    } as const;
+  }
+  async moveThreadToFolder(
+    threadId: string,
+    _ownerEmail: string,
+    folderName: string,
+  ) {
+    const folders = await this.getThunderbirdFolders();
+    const byId = folders.find((folder) => folder.id === folderName);
+    const matches = byId
+      ? [byId]
+      : folders.filter(
+          (folder) => folder.path === folderName || folder.name === folderName,
+        );
+    if (matches.length !== 1)
+      throw new Error(
+        matches.length
+          ? "Folder name is ambiguous; choose its folder ID"
+          : "Destination folder not found",
+      );
+    await this.moveMessageToFolder(threadId, matches[0].id);
+  }
+
+  // Moving to an existing folder is supported; other writes remain unavailable.
+  archiveMessage: EmailProvider["archiveMessage"] = unsupported;
+  archiveMessages: EmailProvider["archiveMessages"] = unsupported;
+  archiveThread: EmailProvider["archiveThread"] = unsupported;
+  archiveThreadWithLabel: EmailProvider["archiveThreadWithLabel"] = unsupported;
+  blockUnsubscribedEmail: EmailProvider["blockUnsubscribedEmail"] = unsupported;
+  bulkArchiveFromSenders: EmailProvider["bulkArchiveFromSenders"] = unsupported;
+  bulkArchiveThreads: EmailProvider["bulkArchiveThreads"] = unsupported;
+  bulkTrashFromSenders: EmailProvider["bulkTrashFromSenders"] = unsupported;
+  checkIfReplySent: EmailProvider["checkIfReplySent"] = unsupported;
+  countReceivedMessages: EmailProvider["countReceivedMessages"] = unsupported;
+  createAutoArchiveFilter: EmailProvider["createAutoArchiveFilter"] =
+    unsupported;
+  createDraft: EmailProvider["createDraft"] = unsupported;
+  createFilter: EmailProvider["createFilter"] = unsupported;
+  createLabel: EmailProvider["createLabel"] = unsupported;
+  deleteDraft: EmailProvider["deleteDraft"] = unsupported;
+  deleteFilter: EmailProvider["deleteFilter"] = unsupported;
+  deleteFolder: EmailProvider["deleteFolder"] = unsupported;
+  deleteLabel: EmailProvider["deleteLabel"] = unsupported;
+  draftEmail: EmailProvider["draftEmail"] = unsupported;
+  forwardEmail: EmailProvider["forwardEmail"] = unsupported;
+  getAccessToken: EmailProvider["getAccessToken"] = unsupported;
+  getAttachment: EmailProvider["getAttachment"] = unsupported;
+  getAttachmentStream: EmailProvider["getAttachmentStream"] = unsupported;
+  getMessageByRfc822MessageId: EmailProvider["getMessageByRfc822MessageId"] =
+    unsupported;
+  getMessagesFromSender: EmailProvider["getMessagesFromSender"] = unsupported;
+  getMessagesWithAttachments: EmailProvider["getMessagesWithAttachments"] =
+    unsupported;
+  getOrCreateFolderIdByName: EmailProvider["getOrCreateFolderIdByName"] =
+    unsupported;
+  getOrCreateInboxZeroLabel: EmailProvider["getOrCreateInboxZeroLabel"] =
+    unsupported;
+  getSentMessageIds: EmailProvider["getSentMessageIds"] = unsupported;
+  getSentThreadsExcluding: EmailProvider["getSentThreadsExcluding"] =
+    unsupported;
+  getThreadsFromSenderWithSubject: EmailProvider["getThreadsFromSenderWithSubject"] =
+    unsupported;
+  getThreadsWithParticipant: EmailProvider["getThreadsWithParticipant"] =
+    unsupported;
+  hasPreviousCommunicationsWithSenderOrDomain: EmailProvider["hasPreviousCommunicationsWithSenderOrDomain"] =
+    unsupported;
+  labelMessage: EmailProvider["labelMessage"] = unsupported;
+  markMessagesReadState: EmailProvider["markMessagesReadState"] = unsupported;
+  markMessagesStarredState: EmailProvider["markMessagesStarredState"] =
+    unsupported;
+  markNotSpam: EmailProvider["markNotSpam"] = unsupported;
+  markRead: EmailProvider["markRead"] = unsupported;
+  markReadThread: EmailProvider["markReadThread"] = unsupported;
+  markSpam: EmailProvider["markSpam"] = unsupported;
+  removeThreadLabel: EmailProvider["removeThreadLabel"] = unsupported;
+  removeThreadLabels: EmailProvider["removeThreadLabels"] = unsupported;
+  renameFolder: EmailProvider["renameFolder"] = unsupported;
+  replyToEmail: EmailProvider["replyToEmail"] = unsupported;
+  sendDraft: EmailProvider["sendDraft"] = unsupported;
+  sendEmail: EmailProvider["sendEmail"] = unsupported;
+  sendEmailWithHtml: EmailProvider["sendEmailWithHtml"] = unsupported;
+  starMessage: EmailProvider["starMessage"] = unsupported;
+  trashMessages: EmailProvider["trashMessages"] = unsupported;
+  trashThread: EmailProvider["trashThread"] = unsupported;
+  unarchiveMessages: EmailProvider["unarchiveMessages"] = unsupported;
+  unarchiveThread: EmailProvider["unarchiveThread"] = unsupported;
+  untrashMessages: EmailProvider["untrashMessages"] = unsupported;
+  untrashThread: EmailProvider["untrashThread"] = unsupported;
+  updateDraft: EmailProvider["updateDraft"] = unsupported;
+  updateLabel: EmailProvider["updateLabel"] = unsupported;
+}
+
+function unsupported(): never {
+  throw new Error(
+    "This Thunderbird connection only supports reading and moving mail; this operation is not available yet.",
+  );
+}
+function asThread(message: ParsedMessage): EmailThread {
+  return {
+    id: message.threadId,
+    messages: [message],
+    snippet: message.snippet,
+  };
+}
+function emptyPage(cursor: string): MailboxSyncPage {
+  return {
+    cursor,
+    upsertedMessages: [],
+    deletedMessageIds: [],
+    hasMore: false,
+    reset: false,
+  };
+}
