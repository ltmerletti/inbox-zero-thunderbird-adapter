@@ -0,0 +1,113 @@
+"use client";
+
+import { useRef, useState } from "react";
+import { toast } from "sonner";
+import { LoadingContent } from "@/components/LoadingContent";
+import {
+  Command,
+  CommandEmpty,
+  CommandGroup,
+  CommandInput,
+  CommandItem,
+  CommandList,
+} from "@/components/ui/command";
+import { Dialog, DialogContent, DialogTitle } from "@/components/ui/dialog";
+import { useFolders } from "@/hooks/useFolders";
+import { useAccount } from "@/providers/EmailAccountProvider";
+import { useOptionalMailClient } from "@inboxzero/mail-react/MailEngineProvider";
+import { flattenOutlookFolders } from "@/utils/outlook/folders";
+import { randomUuid } from "@/utils/uuid";
+
+export function FolderPickerDialog({
+  threadIds,
+  onClose,
+  onApplied,
+}: {
+  threadIds: string[];
+  onClose: () => void;
+  onApplied: (threadIds: string[], folderId: string) => void;
+  mode?: "label" | "move";
+}) {
+  const { emailAccountId, provider } = useAccount();
+  const client = useOptionalMailClient();
+  const { folders, isLoading, error, mutate } = useFolders(provider);
+  const [isPending, setIsPending] = useState(false);
+  const pending = useRef(false);
+
+  async function move(folderId: string) {
+    if (pending.current || !client) return;
+    pending.current = true;
+    setIsPending(true);
+    try {
+      const admission = await client.submitConversations({
+        accountId: emailAccountId,
+        commandId: randomUuid(),
+        conversations: threadIds.map((conversationId) => ({
+          accountId: emailAccountId,
+          conversationId,
+        })),
+        change: { kind: "move", folderId },
+        observedRevision: (await client.getDiagnostics(emailAccountId))
+          .revision,
+      });
+      if (admission.status === "rejected")
+        throw new Error("Couldn't queue this move. Refresh and try again.");
+      toast.success(
+        threadIds.length === 1
+          ? "Move queued"
+          : `Queued ${threadIds.length} messages to move`,
+      );
+      onApplied(threadIds, folderId);
+      mutate().catch(() => {});
+      onClose();
+    } catch (error) {
+      toast.error(
+        error instanceof Error ? error.message : "Couldn't move messages",
+      );
+    } finally {
+      pending.current = false;
+      setIsPending(false);
+    }
+  }
+
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open && !pending.current) onClose();
+      }}
+    >
+      <DialogContent
+        aria-describedby={undefined}
+        className="gap-0 overflow-hidden p-0 sm:max-w-md"
+      >
+        <DialogTitle className="sr-only">Move conversations</DialogTitle>
+        <Command>
+          <CommandInput
+            aria-label="Search folders"
+            placeholder="Move to folder…"
+            disabled={isPending}
+          />
+          <LoadingContent loading={isLoading} error={error}>
+            <CommandList aria-busy={isPending}>
+              <CommandEmpty>No matching folders.</CommandEmpty>
+              <CommandGroup>
+                {flattenOutlookFolders(folders).map((folder) => (
+                  <CommandItem
+                    key={folder.id}
+                    value={folder.id}
+                    keywords={[folder.path]}
+                    onSelect={() => move(folder.id)}
+                    disabled={isPending || !client}
+                  >
+                    {folder.path}
+                  </CommandItem>
+                ))}
+              </CommandGroup>
+            </CommandList>
+          </LoadingContent>
+        </Command>
+      </DialogContent>
+    </Dialog>
+  );
+}
