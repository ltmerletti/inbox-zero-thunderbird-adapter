new file mode 100644
index 0000000..ba28215
--- /dev/null
+++ b/apps/web/utils/email/thunderbird-provider.test.ts
@@ -0,0 +1,103 @@
+import { describe, expect, it, vi } from "vitest";
+import { ThunderbirdProvider } from "./thunderbird-provider";
+import type { ParsedMessage } from "@/utils/types";
+
+function message(id: string, read = false): ParsedMessage {
+  return {
+    id,
+    threadId: id,
+    date: "2026-01-01T00:00:00Z",
+    internalDate: "1767225600000",
+    historyId: "",
+    subject: "Example",
+    snippet: "",
+    inline: [],
+    labelIds: read ? ["INBOX"] : ["INBOX", "UNREAD"],
+    headers: {
+      from: "sender@example.com",
+      to: "owner@example.com",
+      subject: "Example",
+      date: "2026-01-01",
+    },
+  };
+}
+function reader(accountId: string) {
+  return new ThunderbirdProvider({
+    baseUrl: "http://127.0.0.1:7700",
+    token: "test-token-".repeat(5),
+    accountId,
+  });
+}
+
+describe("Thunderbird provider snapshot synchronization", () => {
+  it("paginates snapshots, replays retries, and reports changed flags and deleted messages", async () => {
+    const provider = reader("snapshot-test");
+    const list = vi.spyOn(provider, "getMessagesWithPagination");
+    list.mockResolvedValue({
+      messages: [message("one"), message("two")],
+      nextPageToken: undefined,
+    });
+    const baseline = await provider.getMailboxSyncPage({
+      after: new Date(0),
+      limit: 1,
+    });
+    const first = await provider.getMailboxSyncPage({
+      cursor: baseline.cursor,
+      limit: 1,
+    });
+    expect(first.upsertedMessages.map((m) => m.id)).toEqual(["one"]);
+    expect(first.hasMore).toBe(true);
+    expect(
+      await provider.getMailboxSyncPage({ cursor: baseline.cursor, limit: 1 }),
+    ).toEqual(first);
+    const second = await provider.getMailboxSyncPage({
+      cursor: first.cursor,
+      limit: 1,
+    });
+    expect(second.upsertedMessages.map((m) => m.id)).toEqual(["two"]);
+    expect(second.hasMore).toBe(false);
+    list.mockResolvedValue({
+      messages: [message("two", true), message("three")],
+      nextPageToken: undefined,
+    });
+    const changed = await provider.getMailboxSyncPage({
+      cursor: second.cursor,
+      limit: 100,
+    });
+    expect(changed.upsertedMessages.map((m) => m.id)).toEqual(["two", "three"]);
+    expect(changed.deletedMessageIds).toEqual(["one"]);
+    expect(list).toHaveBeenCalledTimes(2);
+  });
+  it("rejects a sync cursor from a different mailbox and resets unknown positions", async () => {
+    const a = reader("isolated-a"),
+      b = reader("isolated-b");
+    const baseline = await a.getMailboxSyncPage({
+      after: new Date(0),
+      limit: 1,
+    });
+    await b.getMailboxSyncPage({ after: new Date(0), limit: 1 });
+    expect(
+      (await b.getMailboxSyncPage({ cursor: baseline.cursor, limit: 50 }))
+        .reset,
+    ).toBe(true);
+    expect(
+      (await a.getMailboxSyncPage({ cursor: "expired", limit: 50 })).reset,
+    ).toBe(true);
+  });
+  it("fails writes without dispatching a request to Thunderbird", () => {
+    const provider = reader("read-only-test");
+    const fetchSpy = vi.spyOn(globalThis, "fetch");
+    expect(() =>
+      provider.trashThread("one", "owner@example.com", "user"),
+    ).toThrow("read-only");
+    expect(() =>
+      provider.sendEmail({
+        to: "someone@example.com",
+        subject: "Hello",
+        messageText: "Hello",
+      }),
+    ).toThrow("read-only");
+    expect(fetchSpy).not.toHaveBeenCalled();
+    fetchSpy.mockRestore();
+  });
+});
diff --git a/apps/web/utils/email/thunderbird-provider.ts b/apps/web/utils/email/thunderbird-provider.ts
new file mode 100644
index 0000000..8d24754
--- /dev/null
+++ b/apps/web/utils/email/thunderbird-provider.ts
@@ -0,0 +1,405 @@
+import { randomUUID } from "node:crypto";
+import { ThunderbirdMailReader } from "@/utils/email/thunderbird";
+import type {
+  EmailProvider,
+  EmailThread,
+  MailboxSyncPage,
+} from "@/utils/email/types";
+import type { ParsedMessage } from "@/utils/types";
+import type { OutlookSystemFolder } from "@/utils/outlook/folders";
+
+const snapshots = new Map<
+  string,
+  {
+    cursor: string;
+    messages: Map<string, ParsedMessage>;
+    replies: Map<string, MailboxSyncPage>;
+    pending?: {
+      messages: ParsedMessage[];
+      deleted: string[];
+      snapshot: Map<string, ParsedMessage>;
+    };
+    scan?: Promise<void>;
+  }
+>();
+
+export class ThunderbirdProvider
+  extends ThunderbirdMailReader
+  implements EmailProvider
+{
+  readonly localMailSyncStrategy = "account-history";
+
+  toJSON() {
+    return { name: this.name, type: "local-read-only" };
+  }
+
+  async getFolders() {
+    const roles: Record<string, OutlookSystemFolder> = {
+      inbox: "INBOX",
+      sent: "SENT",
+      drafts: "DRAFT",
+      trash: "TRASH",
+      junk: "SPAM",
+      archives: "ARCHIVE",
+    };
+    return (await this.getThunderbirdFolders()).map((folder) => ({
+      id: folder.id,
+      displayName: folder.name,
+      childFolders: [],
+      totalItemCount: folder.total,
+      unreadItemCount: folder.unread,
+      systemType: folder.specialUse.map((role) => roles[role]).find(Boolean),
+    }));
+  }
+
+  async getLabels() {
+    return [] as Awaited<ReturnType<EmailProvider["getLabels"]>>;
+  }
+  async getLabelById(id: string) {
+    return (await this.getLabels()).find((label) => label.id === id) ?? null;
+  }
+  async getLabelByName(name: string) {
+    return (
+      (await this.getLabels()).find((label) => label.name === name) ?? null
+    );
+  }
+  async getSignatures() {
+    return [];
+  }
+  async getFiltersList() {
+    return [];
+  }
+  async getForwardingAddresses() {
+    return [];
+  }
+  async searchContacts() {
+    return [];
+  }
+  async getMessagesBatch(ids: string[]) {
+    return Promise.all(ids.map((id) => this.getMessage(id)));
+  }
+  async getPreviousConversationMessages(ids: string[]) {
+    return this.getMessagesBatch(ids);
+  }
+  async getOriginalMessage(id: string | undefined) {
+    return id ? this.getMessage(id) : null;
+  }
+  async getThread(id: string): Promise<EmailThread> {
+    return asThread(await this.getMessage(id));
+  }
+  async getThreadMessages(id: string) {
+    return (await this.getThread(id)).messages;
+  }
+  async getThreadMessagesInInbox(id: string) {
+    return (await this.getThreadMessages(id)).filter((message) =>
+      message.labelIds?.includes("INBOX"),
+    );
+  }
+  async getLatestMessageInThread(id: string) {
+    return this.getMessage(id);
+  }
+  async getLatestMessageFromThreadSnapshot(
+    thread: Pick<EmailThread, "id" | "messages">,
+  ) {
+    return thread.messages.at(-1) ?? null;
+  }
+  isSentMessage(message: ParsedMessage) {
+    return !!message.labelIds?.includes("SENT");
+  }
+  isReplyInThread(message: ParsedMessage) {
+    return !!message.headers["in-reply-to"];
+  }
+  async watchEmails() {
+    return null;
+  }
+  async unwatchEmails() {}
+
+  async getThreadsWithQuery({
+    query,
+    maxResults,
+    pageToken,
+  }: Parameters<EmailProvider["getThreadsWithQuery"]>[0] = {}) {
+    const page = await this.getMessagesWithPagination({
+      query: query?.q ?? undefined,
+      folderId: query?.folderId ?? query?.labelId ?? undefined,
+      maxResults,
+      pageToken,
+      inboxOnly: query?.type === "inbox",
+      unreadOnly: !!query?.isUnread,
+      before: query?.before ?? undefined,
+      after: query?.after ?? undefined,
+    });
+    if (
+      query?.anyOf?.length ||
+      query?.excludeSplits?.length ||
+      query?.fromEmail ||
+      query?.category
+    )
+      unsupported();
+    return {
+      threads: page.messages.map(asThread),
+      nextPageToken: page.nextPageToken,
+    };
+  }
+  async getThreads(folderId?: string) {
+    return (await this.getThreadsWithQuery({ query: { folderId } })).threads;
+  }
+  async getThreadsWithLabel({
+    labelId,
+    maxResults,
+  }: Parameters<EmailProvider["getThreadsWithLabel"]>[0]) {
+    return (await this.getThreadsWithQuery({ query: { labelId }, maxResults }))
+      .threads;
+  }
+  async getDrafts({ maxResults }: { maxResults?: number } = {}) {
+    return this.messagesInRole("drafts", maxResults);
+  }
+  async getSentMessages(maxResults?: number) {
+    return this.messagesInRole("sent", maxResults);
+  }
+  async getDraft(id: string) {
+    const message = await this.getMessage(id);
+    return message.labelIds?.includes("DRAFT") ? message : null;
+  }
+  async getDraftReferenceForMessage(id: string) {
+    return (await this.getDraft(id)) ? { id } : null;
+  }
+
+  async searchMessages(
+    options: Parameters<EmailProvider["searchMessages"]>[0],
+  ) {
+    if (
+      options.fromEmail ||
+      options.labelName ||
+      (options.labelIds?.length ?? 0) > 1
+    )
+      unsupported();
+    const search = options.mailboxSearch;
+    if (
+      search?.hasAttachment !== undefined ||
+      search?.starred !== undefined ||
+      search?.excludedRoles?.length
+    )
+      unsupported();
+    if (search?.text && !["any", "subject"].includes(search.text.field))
+      unsupported();
+    let folderId = options.labelIds?.[0];
+    const mailbox = search?.mailbox ?? options.folder;
+    if (mailbox && mailbox !== "all" && mailbox !== "inbox") {
+      const role = (
+        {
+          drafts: "drafts",
+          sent: "sent",
+          trash: "trash",
+          spam: "junk",
+          archive: "archives",
+        } as Record<string, string>
+      )[mailbox];
+      if (!role) unsupported();
+      folderId = (await this.getThunderbirdFolders()).find((folder) =>
+        folder.specialUse.includes(role),
+      )?.id;
+      if (!folderId) return { messages: [], nextPageToken: undefined };
+    }
+    const page = await this.getMessagesWithPagination({
+      query: search?.text?.value ?? options.query,
+      maxResults: options.maxResults,
+      pageToken: options.pageToken,
+      folderId,
+      inboxOnly: mailbox === "inbox",
+      unreadOnly: search?.read === false || options.readState === "unread",
+    });
+    const messages = page.messages.filter(
+      (message) =>
+        search?.read !== true || !message.labelIds?.includes("UNREAD"),
+    );
+    return { ...page, messages };
+  }
+  async searchThreads(options: Parameters<EmailProvider["searchThreads"]>[0]) {
+    const page = await this.searchMessages(options);
+    return {
+      threads: page.messages.map(asThread),
+      nextPageToken: page.nextPageToken,
+    };
+  }
+
+  async getMailboxSyncPage({
+    cursor,
+    after,
+    limit,
+  }: Parameters<
+    EmailProvider["getMailboxSyncPage"]
+  >[0]): Promise<MailboxSyncPage> {
+    const key = this.selectedAccount();
+    let state = snapshots.get(key);
+    if (after) {
+      state = { cursor: randomUUID(), messages: new Map(), replies: new Map() };
+      snapshots.set(key, state);
+      return emptyPage(state.cursor);
+    }
+    if (!state || !cursor) return { ...emptyPage(""), reset: true };
+    const replay = state.replies.get(cursor);
+    if (replay) return replay;
+    if (cursor !== state.cursor) return { ...emptyPage(""), reset: true };
+    if (!state.pending) {
+      state.scan ??= this.scanSnapshot(state).finally(() => {
+        if (state) state.scan = undefined;
+      });
+      await state.scan;
+    }
+    const cached = state.replies.get(cursor);
+    if (cached) return cached;
+    if (cursor !== state.cursor) return { ...emptyPage(""), reset: true };
+    const pending = state.pending!;
+    const changed = pending.messages.splice(0, Math.min(limit, 100));
+    const hasMore = pending.messages.length > 0;
+    const next = randomUUID();
+    const page: MailboxSyncPage = {
+      cursor: next,
+      upsertedMessages: changed,
+      deletedMessageIds: hasMore ? [] : pending.deleted,
+      hasMore,
+      reset: false,
+    };
+    state.replies.set(cursor, page);
+    if (state.replies.size > 200)
+      state.replies.delete(state.replies.keys().next().value!);
+    state.cursor = next;
+    if (!hasMore) {
+      state.messages = pending.snapshot;
+      state.pending = undefined;
+    }
+    return page;
+  }
+
+  private async scanSnapshot(
+    state: NonNullable<ReturnType<typeof snapshots.get>>,
+  ) {
+    const snapshot = new Map<string, ParsedMessage>();
+    let token: string | undefined;
+    do {
+      const page = await this.getMessagesWithPagination({
+        maxResults: 100,
+        pageToken: token,
+        includeDrafts: true,
+      });
+      for (const message of page.messages) snapshot.set(message.id, message);
+      token = page.nextPageToken;
+    } while (token);
+    state.pending = {
+      snapshot,
+      messages: [...snapshot.values()].filter(
+        (message) =>
+          JSON.stringify(message) !==
+          JSON.stringify(state.messages.get(message.id)),
+      ),
+      deleted: [...state.messages.keys()].filter((id) => !snapshot.has(id)),
+    };
+  }
+  private async messagesInRole(role: string, maxResults?: number) {
+    const folder = (await this.getThunderbirdFolders()).find((folder) =>
+      folder.specialUse.includes(role),
+    );
+    if (!folder) return [];
+    return (
+      await this.getMessagesWithPagination({ folderId: folder.id, maxResults })
+    ).messages;
+  }
+
+  async syncLocalMail() {
+    return {
+      status: "unsupported",
+      strategy: this.localMailSyncStrategy,
+    } as const;
+  }
+  // Unsupported operations fail explicitly; the Thunderbird extension itself has no write permissions.
+  archiveMessage: EmailProvider["archiveMessage"] = unsupported;
+  archiveMessages: EmailProvider["archiveMessages"] = unsupported;
+  archiveThread: EmailProvider["archiveThread"] = unsupported;
+  archiveThreadWithLabel: EmailProvider["archiveThreadWithLabel"] = unsupported;
+  blockUnsubscribedEmail: EmailProvider["blockUnsubscribedEmail"] = unsupported;
+  bulkArchiveFromSenders: EmailProvider["bulkArchiveFromSenders"] = unsupported;
+  bulkArchiveThreads: EmailProvider["bulkArchiveThreads"] = unsupported;
+  bulkTrashFromSenders: EmailProvider["bulkTrashFromSenders"] = unsupported;
+  checkIfReplySent: EmailProvider["checkIfReplySent"] = unsupported;
+  countReceivedMessages: EmailProvider["countReceivedMessages"] = unsupported;
+  createAutoArchiveFilter: EmailProvider["createAutoArchiveFilter"] =
+    unsupported;
+  createDraft: EmailProvider["createDraft"] = unsupported;
+  createFilter: EmailProvider["createFilter"] = unsupported;
+  createLabel: EmailProvider["createLabel"] = unsupported;
+  deleteDraft: EmailProvider["deleteDraft"] = unsupported;
+  deleteFilter: EmailProvider["deleteFilter"] = unsupported;
+  deleteFolder: EmailProvider["deleteFolder"] = unsupported;
+  deleteLabel: EmailProvider["deleteLabel"] = unsupported;
+  draftEmail: EmailProvider["draftEmail"] = unsupported;
+  forwardEmail: EmailProvider["forwardEmail"] = unsupported;
+  getAccessToken: EmailProvider["getAccessToken"] = unsupported;
+  getAttachment: EmailProvider["getAttachment"] = unsupported;
+  getAttachmentStream: EmailProvider["getAttachmentStream"] = unsupported;
+  getMessageByRfc822MessageId: EmailProvider["getMessageByRfc822MessageId"] =
+    unsupported;
+  getMessagesFromSender: EmailProvider["getMessagesFromSender"] = unsupported;
+  getMessagesWithAttachments: EmailProvider["getMessagesWithAttachments"] =
+    unsupported;
+  getOrCreateFolderIdByName: EmailProvider["getOrCreateFolderIdByName"] =
+    unsupported;
+  getOrCreateInboxZeroLabel: EmailProvider["getOrCreateInboxZeroLabel"] =
+    unsupported;
+  getSentMessageIds: EmailProvider["getSentMessageIds"] = unsupported;
+  getSentThreadsExcluding: EmailProvider["getSentThreadsExcluding"] =
+    unsupported;
+  getThreadsFromSenderWithSubject: EmailProvider["getThreadsFromSenderWithSubject"] =
+    unsupported;
+  getThreadsWithParticipant: EmailProvider["getThreadsWithParticipant"] =
+    unsupported;
+  hasPreviousCommunicationsWithSenderOrDomain: EmailProvider["hasPreviousCommunicationsWithSenderOrDomain"] =
+    unsupported;
+  labelMessage: EmailProvider["labelMessage"] = unsupported;
+  markMessagesReadState: EmailProvider["markMessagesReadState"] = unsupported;
+  markMessagesStarredState: EmailProvider["markMessagesStarredState"] =
+    unsupported;
+  markNotSpam: EmailProvider["markNotSpam"] = unsupported;
+  markRead: EmailProvider["markRead"] = unsupported;
+  markReadThread: EmailProvider["markReadThread"] = unsupported;
+  markSpam: EmailProvider["markSpam"] = unsupported;
+  moveThreadToFolder: EmailProvider["moveThreadToFolder"] = unsupported;
+  removeThreadLabel: EmailProvider["removeThreadLabel"] = unsupported;
+  removeThreadLabels: EmailProvider["removeThreadLabels"] = unsupported;
+  renameFolder: EmailProvider["renameFolder"] = unsupported;
+  replyToEmail: EmailProvider["replyToEmail"] = unsupported;
+  sendDraft: EmailProvider["sendDraft"] = unsupported;
+  sendEmail: EmailProvider["sendEmail"] = unsupported;
+  sendEmailWithHtml: EmailProvider["sendEmailWithHtml"] = unsupported;
+  starMessage: EmailProvider["starMessage"] = unsupported;
+  trashMessages: EmailProvider["trashMessages"] = unsupported;
+  trashThread: EmailProvider["trashThread"] = unsupported;
+  unarchiveMessages: EmailProvider["unarchiveMessages"] = unsupported;
+  unarchiveThread: EmailProvider["unarchiveThread"] = unsupported;
+  untrashMessages: EmailProvider["untrashMessages"] = unsupported;
+  untrashThread: EmailProvider["untrashThread"] = unsupported;
+  updateDraft: EmailProvider["updateDraft"] = unsupported;
+  updateLabel: EmailProvider["updateLabel"] = unsupported;
+}
+
+function unsupported(): never {
+  throw new Error(
+    "This Thunderbird connection is read-only; this operation is not available yet.",
+  );
+}
+function asThread(message: ParsedMessage): EmailThread {
+  return {
+    id: message.threadId,
+    messages: [message],
+    snippet: message.snippet,
+  };
+}
+function emptyPage(cursor: string): MailboxSyncPage {
+  return {
+    cursor,
+    upsertedMessages: [],
+    deletedMessageIds: [],
+    hasMore: false,
+    reset: false,
+  };
+}
diff --git a/apps/web/utils/email/thunderbird.ts b/apps/web/utils/email/thunderbird.ts
new file mode 100644
index 0000000..964e49b
--- /dev/null
+++ b/apps/web/utils/email/thunderbird.ts
@@ -0,0 +1,393 @@
+import { createHash } from "node:crypto";
+import type { EmailProvider, EmailFolderCount } from "@/utils/email/types";
+import type { ParsedMessage } from "@/utils/types";
+
+export type ThunderbirdAccount = {
+  id: string;
+  name: string;
+  type: string;
+  email: string;
+};
+export type ThunderbirdFolder = {
+  id: string;
+  accountId: string;
+  name: string;
+  path: string;
+  specialUse: string[];
+  total: number;
+  unread: number;
+};
+type ThunderbirdMessage = {
+  id: number;
+  accountId: string;
+  folderId: string;
+  date: string;
+  author: string;
+  recipients: string[];
+  ccList: string[];
+  subject: string;
+  headerMessageId: string;
+  read: boolean;
+  flagged: boolean;
+  tags: string[];
+  headers?: Record<string, string[]>;
+  parts?: {
+    text: string;
+    html: string;
+    attachments: {
+      partName: string;
+      name: string;
+      contentType: string;
+      size: number;
+    }[];
+  };
+};
+
+type ThunderbirdReader = Pick<
+  EmailProvider,
+  | "getMessage"
+  | "getMessagesWithPagination"
+  | "getInboxMessages"
+  | "getInboxStats"
+  | "getFolderCounts"
+>;
+
+const messageReferences = new Map<string, Map<string, number>>();
+
+export class ThunderbirdMailReader implements ThunderbirdReader {
+  readonly name = "thunderbird";
+  readonly readOnly = true;
+  private readonly baseUrl: string;
+  private readonly token: string;
+  protected readonly accountId?: string;
+
+  constructor({
+    baseUrl,
+    token,
+    accountId,
+  }: { baseUrl: string; token: string; accountId?: string }) {
+    const url = new URL(baseUrl);
+    if (
+      url.protocol !== "http:" ||
+      url.hostname !== "127.0.0.1" ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash ||
+      url.pathname !== "/"
+    ) {
+      throw new Error(
+        "Thunderbird bridge must use an HTTP address on 127.0.0.1",
+      );
+    }
+    if (token.length < 32)
+      throw new Error(
+        "A private bridge token of at least 32 characters is required",
+      );
+    this.baseUrl = url.origin;
+    this.token = token;
+    this.accountId = accountId;
+  }
+
+  async getStatus() {
+    return this.request<{
+      bridge: string;
+      extension: string;
+      readOnly: boolean;
+    }>("GET", "/bridge/status");
+  }
+
+  async getAccounts() {
+    return this.request<ThunderbirdAccount[]>("GET", "/inbox-zero/accounts");
+  }
+
+  async getThunderbirdFolders() {
+    const folders = await this.request<ThunderbirdFolder[]>(
+      "POST",
+      "/inbox-zero/folders",
+      {
+        accountId: this.selectedAccount(),
+      },
+    );
+    if (
+      !Array.isArray(folders) ||
+      folders.some((folder) => folder.accountId !== this.accountId)
+    ) {
+      throw new Error("Bridge returned folders outside the selected account");
+    }
+    return folders;
+  }
+
+  async getFolderCounts(): Promise<EmailFolderCount[]> {
+    return (await this.getThunderbirdFolders()).map((folder) => ({
+      id: folder.id,
+      name: folder.name,
+      total: folder.total,
+      unread: folder.unread,
+    }));
+  }
+
+  async getMessage(messageId: string): Promise<ParsedMessage> {
+    parseMessageId(messageId, this.selectedAccount());
+    const references = this.references();
+    let id = references.get(messageId);
+    if (!id) id = await this.findMessageReference(messageId);
+    let message: ThunderbirdMessage | undefined;
+    try {
+      message = await this.readNativeMessage(id);
+    } catch (error) {
+      if (
+        !(error instanceof Error) ||
+        !/message.*not found/i.test(error.message)
+      )
+        throw error;
+    }
+    if (!message || toInboxZeroMessage(message).id !== messageId) {
+      references.delete(messageId);
+      id = await this.findMessageReference(messageId);
+      message = await this.readNativeMessage(id);
+      if (toInboxZeroMessage(message).id !== messageId)
+        throw new ThunderbirdMessageNotFoundError(
+          "Message not found: Thunderbird's message IDs changed; refresh the mailbox",
+        );
+    }
+    return withFolderRole(
+      toInboxZeroMessage(message),
+      await this.getThunderbirdFolders(),
+    );
+  }
+
+  async getMessagesWithPagination(
+    options: Parameters<EmailProvider["getMessagesWithPagination"]>[0] = {},
+  ) {
+    if (options.before || options.after) {
+      throw new Error("Date filters are not supported by this adapter yet");
+    }
+    const limit = options.maxResults ?? 25;
+    if (!Number.isInteger(limit) || limit < 1 || limit > 100)
+      throw new Error("Page size must be 1–100");
+    let folderId = options.folderId;
+    if (options.inboxOnly) {
+      const folders = await this.getThunderbirdFolders();
+      const inbox = folders.find((folder) =>
+        folder.specialUse.includes("inbox"),
+      );
+      if (!inbox)
+        throw new Error("This account has no identifiable inbox folder");
+      folderId = inbox.id;
+    }
+    const page = await this.request<{
+      messages: ThunderbirdMessage[];
+      nextCursor?: string;
+    }>("POST", "/inbox-zero/messages", {
+      accountId: this.selectedAccount(),
+      folderId,
+      limit,
+      query: options.query,
+      unreadOnly: options.unreadOnly,
+      cursor: options.pageToken,
+    });
+    if (!Array.isArray(page.messages))
+      throw new Error("Bridge returned an invalid message page");
+    for (const message of page.messages) this.assertMessageAccount(message);
+    const folders = await this.getThunderbirdFolders();
+    const references = this.references();
+    const messages = page.messages.map((message) => {
+      const parsed = withFolderRole(toInboxZeroMessage(message), folders);
+      references.set(parsed.id, message.id);
+      return parsed;
+    });
+    return { messages, nextPageToken: page.nextCursor };
+  }
+
+  async getInboxMessages(maxResults = 25) {
+    return (
+      await this.getMessagesWithPagination({ inboxOnly: true, maxResults })
+    ).messages;
+  }
+
+  async getInboxStats() {
+    const folders = await this.getThunderbirdFolders();
+    const inbox = folders.find((folder) => folder.specialUse.includes("inbox"));
+    if (!inbox)
+      throw new Error("This account has no identifiable inbox folder");
+    return { total: inbox.total, unread: inbox.unread };
+  }
+
+  protected selectedAccount() {
+    if (!this.accountId)
+      throw new Error("Select a Thunderbird account before reading mail");
+    return this.accountId;
+  }
+
+  private references() {
+    const account = this.selectedAccount();
+    let references = messageReferences.get(account);
+    if (!references) {
+      references = new Map();
+      messageReferences.set(account, references);
+    }
+    return references;
+  }
+
+  private async readNativeMessage(id: number) {
+    const message = await this.request<ThunderbirdMessage>(
+      "POST",
+      "/inbox-zero/message",
+      { accountId: this.accountId, messageId: id },
+    );
+    this.assertMessageAccount(message);
+    return message;
+  }
+
+  private async findMessageReference(messageId: string): Promise<number> {
+    let pageToken: string | undefined;
+    do {
+      const page = await this.getMessagesWithPagination({
+        maxResults: 100,
+        pageToken,
+        includeDrafts: true,
+      });
+      if (page.messages.some((message) => message.id === messageId))
+        return this.references().get(messageId)!;
+      pageToken = page.nextPageToken;
+    } while (pageToken);
+    throw new ThunderbirdMessageNotFoundError(
+      "Message not found: Thunderbird's message IDs changed or the message was moved; refresh the mailbox",
+    );
+  }
+
+  private assertMessageAccount(message: ThunderbirdMessage) {
+    if (message.accountId !== this.selectedAccount())
+      throw new Error("Message belongs to another account");
+    if (
+      !Number.isSafeInteger(message.id) ||
+      message.id < 1 ||
+      !Number.isFinite(Date.parse(message.date))
+    ) {
+      throw new Error("Bridge returned invalid message metadata");
+    }
+  }
+
+  private async request<T>(
+    method: "GET" | "POST",
+    path: string,
+    body?: unknown,
+  ): Promise<T> {
+    const response = await fetch(`${this.baseUrl}${path}`, {
+      method,
+      redirect: "error",
+      signal: AbortSignal.timeout(10_000),
+      headers: {
+        Authorization: `Bearer ${this.token}`,
+        "Content-Type": "application/json",
+        "X-TB-Timeout": "8000",
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    const data = await response.json();
+    if (!response.ok || data?.error) {
+      throw new Error(
+        data?.error || `Thunderbird bridge returned HTTP ${response.status}`,
+      );
+    }
+    return data as T;
+  }
+}
+
+function parseMessageId(value: string, accountId: string) {
+  const prefix = `tb:${encodeURIComponent(accountId)}:`;
+  if (!value.startsWith(prefix))
+    throw new Error("Message ID belongs to another account");
+  if (!/^[a-f0-9]{32}$/.test(value.slice(prefix.length)))
+    throw new ThunderbirdMessageNotFoundError(
+      "Invalid message ID: cached Thunderbird reference is no longer available",
+    );
+}
+
+class ThunderbirdMessageNotFoundError extends Error {
+  readonly status = 404;
+}
+
+function withFolderRole(
+  message: ParsedMessage,
+  folders: ThunderbirdFolder[],
+): ParsedMessage {
+  const roles: Record<string, string> = {
+    inbox: "INBOX",
+    sent: "SENT",
+    drafts: "DRAFT",
+    trash: "TRASH",
+    junk: "SPAM",
+    archives: "ARCHIVE",
+  };
+  const folder = folders.find((folder) => folder.id === message.parentFolderId);
+  const labels = (folder?.specialUse ?? [])
+    .map((role) => roles[role])
+    .filter(Boolean);
+  return { ...message, labelIds: [...(message.labelIds ?? []), ...labels] };
+}
+
+export function toInboxZeroMessage(message: ThunderbirdMessage): ParsedMessage {
+  // Thunderbird's numeric IDs can be reused after restart. A fingerprint
+  // prevents a cached reference from opening a different email.
+  const identity = JSON.stringify([
+    message.folderId,
+    message.headerMessageId || [message.date, message.author, message.subject],
+  ]);
+  const fingerprint = createHash("sha256")
+    .update(identity)
+    .digest("hex")
+    .slice(0, 32);
+  const id = `tb:${encodeURIComponent(message.accountId)}:${fingerprint}`;
+  const header = (name: string) => message.headers?.[name]?.join(" ");
+  const textPlain = message.parts?.text;
+  const textHtml = message.parts?.html;
+  const labelIds = [...message.tags];
+  if (!message.read) labelIds.push("UNREAD");
+  if (message.flagged) labelIds.push("STARRED");
+  return {
+    id,
+    // Conversation grouping will require RFC reference indexing.
+    threadId: id,
+    historyId: "",
+    date: message.date,
+    internalDate: String(Date.parse(message.date)),
+    parentFolderId: message.folderId,
+    subject: message.subject,
+    snippet: textPlain?.trim().replace(/\s+/g, " ").slice(0, 200) || "",
+    textPlain,
+    textHtml,
+    bodyContentType: textPlain ? "text" : textHtml ? "html" : undefined,
+    labelIds,
+    inline: [],
+    hasAttachment: message.parts
+      ? !!message.parts.attachments.length
+      : undefined,
+    attachments: message.parts?.attachments.map((attachment) => ({
+      attachmentId: attachment.partName,
+      filename: attachment.name,
+      mimeType: attachment.contentType,
+      size: attachment.size,
+      headers: {
+        "content-description": "",
+        "content-id": "",
+        "content-transfer-encoding": "",
+        "content-type": attachment.contentType,
+      },
+    })),
+    headers: {
+      from: message.author,
+      to: message.recipients.join(", "),
+      cc: message.ccList.join(", "),
+      subject: message.subject,
+      date: header("date") || message.date,
+      "message-id": header("message-id") || message.headerMessageId,
+      "in-reply-to": header("in-reply-to"),
+      references: header("references"),
+      "reply-to": header("reply-to"),
+      "list-unsubscribe": header("list-unsubscribe"),
+      "list-unsubscribe-post": header("list-unsubscribe-post"),
+    },
+  };
+}
diff --git a/compose.thunderbird.yaml b/compose.thunderbird.yaml
new file mode 100644
