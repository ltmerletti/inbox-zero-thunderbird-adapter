@@ -0,0 +1,66 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import { signIn } from "@/utils/auth-client";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+
+export function ThunderbirdLoginForm() {
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setLoading(true);
+    setError("");
+    const form = new FormData(event.currentTarget);
+    try {
+      const result = await signIn.email({
+        email: String(form.get("email")),
+        password: String(form.get("password")),
+      });
+      if (result.error)
+        throw new Error(result.error.message || "Sign-in failed");
+      window.location.assign("/accounts");
+    } catch (error) {
+      setError(error instanceof Error ? error.message : "Sign-in failed");
+    } finally {
+      setLoading(false);
+    }
+  }
+  return (
+    <form onSubmit={submit} className="mb-6 flex flex-col gap-3">
+      <p className="text-sm text-muted-foreground">
+        Use the local Inbox Zero login for your connected Thunderbird mailbox.
+        AI is disabled.
+      </p>
+      <label className="text-sm" htmlFor="local-email">
+        Email
+        <Input
+          id="local-email"
+          name="email"
+          type="email"
+          autoComplete="username"
+          required
+        />
+      </label>
+      <label className="text-sm" htmlFor="local-password">
+        Local password
+        <Input
+          id="local-password"
+          name="password"
+          type="password"
+          autoComplete="current-password"
+          required
+        />
+      </label>
+      {error && (
+        <p role="alert" className="text-sm text-destructive">
+          {error}
+        </p>
+      )}
+      <Button type="submit" disabled={loading}>
+        {loading ? "Signing in…" : "Sign in to local Inbox Zero"}
+      </Button>
+    </form>
+  );
+}
diff --git a/apps/web/scripts/setup-thunderbird.mts b/apps/web/scripts/setup-thunderbird.mts
new file mode 100644
index 0000000..afc5a04
--- /dev/null
+++ b/apps/web/scripts/setup-thunderbird.mts
@@ -0,0 +1,118 @@
+import { config } from "dotenv";
+import { readFile } from "node:fs/promises";
+import { hashPassword, verifyPassword } from "better-auth/crypto";
+import { PrismaPg } from "@prisma/adapter-pg";
+import { PrismaClient } from "../generated/prisma/client";
+import { ThunderbirdMailReader } from "../utils/email/thunderbird";
+
+config({ path: ".env.local", quiet: true });
+if (
+  process.env.LOCAL_THUNDERBIRD_ENABLED !== "true" ||
+  process.env.LOCAL_AI_DISABLED !== "true"
+)
+  throw new Error("Local Thunderbird and AI-off configuration are required");
+const values = JSON.parse(
+  await readFile(
+    new URL(
+      "../../../../thunderbird-inbox-zero/.private/inbox-zero-config.json",
+      import.meta.url,
+    ),
+    "utf8",
+  ),
+);
+const reader = new ThunderbirdMailReader({
+  baseUrl: process.env.THUNDERBIRD_BRIDGE_URL!,
+  token: process.env.THUNDERBIRD_BRIDGE_TOKEN!,
+});
+const accounts = await reader.getAccounts();
+if (accounts.length !== 1 || !accounts[0].email)
+  throw new Error("Setup requires exactly one connected Thunderbird account");
+const mailbox = accounts[0];
+const db = new PrismaClient({
+  adapter: new PrismaPg({ connectionString: process.env.DATABASE_URL! }),
+});
+try {
+  const existing = await db.user.findUnique({
+    where: { email: mailbox.email },
+  });
+  const user =
+    existing ??
+    (await db.user.create({
+      data: {
+        email: mailbox.email,
+        name: mailbox.name,
+        emailVerified: true,
+        completedOnboardingAt: new Date(),
+        surveyFeatures: [],
+      },
+    }));
+  const credential = await db.account.findFirst({
+    where: { userId: user.id, provider: "credential" },
+  });
+  if (credential) {
+    if (
+      !credential.password ||
+      !(await verifyPassword({
+        hash: credential.password,
+        password: values.password,
+      }))
+    )
+      throw new Error(
+        "Existing local login has a different password; it was not changed",
+      );
+  } else {
+    await db.account.create({
+      data: {
+        userId: user.id,
+        provider: "credential",
+        providerAccountId: user.id,
+        password: await hashPassword(values.password),
+      },
+    });
+  }
+  const linked = await db.account.upsert({
+    where: {
+      provider_providerAccountId: {
+        provider: "thunderbird",
+        providerAccountId: mailbox.id,
+      },
+    },
+    create: {
+      userId: user.id,
+      provider: "thunderbird",
+      providerAccountId: mailbox.id,
+    },
+    update: {},
+  });
+  if (linked.userId !== user.id)
+    throw new Error(
+      "Thunderbird account is already linked to another local user",
+    );
+  const emailAccount = await db.emailAccount.upsert({
+    where: { email: mailbox.email },
+    create: {
+      userId: user.id,
+      accountId: linked.id,
+      email: mailbox.email,
+      name: mailbox.name,
+      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
+      followUpAutoDraftEnabled: false,
+      sentMessageOpenTrackingEnabled: false,
+      includeSentWithSignature: false,
+    },
+    update: {},
+  });
+  if (emailAccount.userId !== user.id || emailAccount.accountId !== linked.id)
+    throw new Error(
+      "Mailbox is already linked differently; no ownership was changed",
+    );
+  console.log(
+    JSON.stringify({
+      emailAccountId: emailAccount.id,
+      provider: "thunderbird",
+      aiDisabled: true,
+    }),
+  );
+} finally {
+  await db.$disconnect();
+}
