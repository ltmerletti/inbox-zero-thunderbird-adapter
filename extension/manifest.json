{
  "manifest_version": 2,
  "name": "Inbox Zero Thunderbird Reader",
  "version": "0.2.0",
  "description": "Local mail connection for Inbox Zero with folder moves.",
  "browser_specific_settings": {
    "gecko": {
      "id": "inbox-zero-reader@local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove"
  ],
  "background": {
    "scripts": [
      "config.js",
      "src/inbox-zero.js"
    ]
  }
}